# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (backend/.env)
# ==============================================================================

# Core Application & Security
PROJECT_NAME="Autonomous Travel & Group Itinerary Coordinator"
DATABASE_URL="sqlite:///./travel_planner.db"
APP_ENV="development"
SECRET_KEY="dev-secret-key-change-in-production-token-secret"
TOKEN_EXPIRE_HOURS=72
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174"

# External Google Maps Platform APIs (Places API, Distance Matrix, Routes API)
GOOGLE_MAPS_API_KEY=""

# External LLM Engine APIs (Optional for live LLM generation; falls back to deterministic local solver)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
LLM_MODEL_NAME="gemini-3.1-flash-lite"
MAX_PLANNER_ITERATIONS=5

# Default admin account bootstrapped on first startup.
# Leave BOTH empty to skip seeding (no default admin created — recommended for production).
# If set, the admin account is only created if one doesn't already exist.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (frontend/.env)
# ==============================================================================
# Backend API Base URL (defaults to http://localhost:8000)
# VITE_API_URL="http://localhost:8000"
