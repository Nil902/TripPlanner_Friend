{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.2.0",
  "project": "travel-itinerary-agent",
  "model_providers_matrix": {
    "gemini": {
      "deep_reasoning": "Gemini 3.1 Pro",
      "fast_execution": "Gemini 3.8 Flash (High)",
      "lightweight": "Gemini 3.1 Flash-Lite"
    },
    "claude": {
      "deep_reasoning": "Claude Opus 4.6",
      "fast_execution": "Claude Sonnet 4.6",
      "lightweight": "Claude Haiku 4.5"
    },
    "openai_gpt": {
      "deep_reasoning": "GPT-OSS 120B (Thinking) / o1",
      "fast_execution": "GPT-OSS 120B / GPT-4o",
      "lightweight": "GPT-OSS 20B / GPT-4o-mini"
    }
  },
  "agents": {
    "planner": {
      "role": "Architectural Planning & Constraint Balancing",
      "antigravity_cli_arg": "pro",
      "recommended_models": {
        "gemini": "Gemini 3.1 Pro",
        "claude": "Claude Opus 4.6",
        "gpt_oss": "GPT-OSS 120B (Thinking) / o1"
      },
      "performance_rationale": "High-order reasoning for multi-traveler budget conflicts, transit trade-offs, and fallback hierarchy without altering code.",
      "allowed_tools": [
        "view_file",
        "list_dir",
        "grep_search",
        "find_by_name",
        "read_url_content"
      ],
      "disallowed_tools": [
        "write_to_file",
        "replace_file_content",
        "run_command"
      ],
      "path_restrictions": {
        "read": ["**/*"],
        "write": []
      }
    },
    "debugger": {
      "role": "Root-Cause Analysis & Defect Isolation",
      "antigravity_cli_arg": "pro",
      "recommended_models": {
        "gemini": "Gemini 3.1 Pro",
        "claude": "Claude Opus 4.6 / Claude Sonnet 4.6 (Thinking)",
        "gpt_oss": "GPT-OSS 120B (Thinking)"
      },
      "performance_rationale": "Precise defect isolation across multi-layer async traces, validator rounding divergences, and API contract boundaries.",
      "allowed_tools": [
        "view_file",
        "list_dir",
        "grep_search",
        "find_by_name",
        "write_to_file",
        "replace_file_content",
        "run_command"
      ],
      "path_restrictions": {
        "read": ["**/*"],
        "write": [
          "backend/**",
          "frontend/**",
          "packages/shared/**"
        ]
      }
    },
    "backend-executor": {
      "role": "FastAPI, SQLModel & Validator Implementation",
      "antigravity_cli_arg": "flash",
      "recommended_models": {
        "gemini": "Gemini 3.8 Flash (High)",
        "claude": "Claude Sonnet 4.6",
        "gpt_oss": "GPT-OSS 120B / GPT-4o"
      },
      "performance_rationale": "Fast and strictly typed Python code authoring, SQLModel schema composition, pure mathematical validator functions, and async pytest fixtures.",
      "allowed_tools": [
        "view_file",
        "list_dir",
        "grep_search",
        "find_by_name",
        "write_to_file",
        "replace_file_content",
        "run_command"
      ],
      "path_restrictions": {
        "read": ["**/*"],
        "write": [
          "backend/**",
          "packages/shared/**",
          "docs/api/**",
          "tests/**"
        ]
      }
    },
    "frontend-executor": {
      "role": "React SPA, Tailwind CSS & Mapping Widgets",
      "antigravity_cli_arg": "flash",
      "recommended_models": {
        "gemini": "Gemini 3.8 Flash (High)",
        "claude": "Claude Sonnet 4.6",
        "gpt_oss": "GPT-OSS 120B / GPT-4o"
      },
      "performance_rationale": "High-fidelity React component development, clean Tailwind layout styling, Leaflet map overlays, and resilient loading/error state handling.",
      "allowed_tools": [
        "view_file",
        "list_dir",
        "grep_search",
        "find_by_name",
        "write_to_file",
        "replace_file_content",
        "run_command"
      ],
      "path_restrictions": {
        "read": ["**/*"],
        "write": [
          "frontend/**"
        ]
      }
    },
    "verifier": {
      "role": "Test Runner, Static Analysis & Audit Reporter",
      "antigravity_cli_arg": "flash",
      "recommended_models": {
        "gemini": "Gemini 3.8 Flash (High)",
        "claude": "Claude Sonnet 4.6 / Claude Haiku 4.5",
        "gpt_oss": "GPT-OSS 120B / GPT-4o-mini"
      },
      "performance_rationale": "Executes testing and linting pipelines (pytest, vitest, ruff, mypy) and reports structured pass/fail matrices without latency overhead.",
      "allowed_tools": [
        "view_file",
        "list_dir",
        "grep_search",
        "find_by_name",
        "run_command"
      ],
      "disallowed_tools": [
        "write_to_file",
        "replace_file_content"
      ],
      "path_restrictions": {
        "read": ["**/*"],
        "write": []
      }
    }
  }
}
